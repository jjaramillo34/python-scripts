# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Optional extra keys (comma-separated) so you can rotate without downtime
# API_KEYS=

# development | production
ENVIRONMENT=development

# Docs are on in development, off in production unless set to true
# ENABLE_DOCS=true

# Browser origins allowed to call the API (comma-separated). Empty = no CORS.
# ALLOWED_ORIGINS=https://yourdomain.com

# Optional host allowlist (comma-separated)
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Trust X-Forwarded-For / X-Real-IP (set true behind Railway, Render, Heroku, nginx)
# TRUST_PROXY=true

# RATE_LIMIT_SEARCH_PER_MINUTE=30
# RATE_LIMIT_AUTH_FAIL_PER_MINUTE=10
